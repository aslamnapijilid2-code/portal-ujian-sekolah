# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT VARIABLE (PORTAL UJIAN ONLINE SDN 4 SOJOL UTARA)
# PENTING: File ini HANYA berisi contoh placeholder untuk publikasi repositori GitHub.
# JANGAN meletakkan password asli atau API key asli di dalam file ini.
# Untuk penggunaan lokal, salin file ini menjadi .env dan masukkan nilai yang sesuai.
# ==============================================================================

# Port server (Google Cloud Run akan mengisi PORT secara otomatis)
PORT=3000

# Password / Kode Akses Guru Pengampu
# Atur password rahasia ini di server environment variable (misal Cloud Run Console atau file .env)
TEACHER_PASSWORD="your_secure_teacher_password_here"

# (Opsional) Gemini API Key untuk fitur asisten evaluasi pembelajaran bertenaga AI
GEMINI_API_KEY="your_gemini_api_key_here"

# (Opsional) URL aplikasi
APP_URL="http://localhost:3000"

# ==============================================================================
# KONFIGURASI FIREBASE CLOUD FIRESTORE & AUTHENTICATION (SDN 4 SOJOL UTARA)
# Proyek: portal-ujian-sdn4-sojol-utara
# Lokasi Firestore: asia-southeast2 (Jakarta)
# Salin konfigurasi Web App Firebase yang sebenarnya dari Firebase Console ke file .env
# ==============================================================================
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="portal-ujian-sdn4-sojol-utara.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="portal-ujian-sdn4-sojol-utara"
VITE_FIREBASE_STORAGE_BUCKET="portal-ujian-sdn4-sojol-utara.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your_messaging_sender_id_here"
VITE_FIREBASE_APP_ID="your_firebase_app_id_here"

